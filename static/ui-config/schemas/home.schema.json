{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradstudio.org/schemas/ui/home.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "hero", "blocks"],
  "properties": {
    "$schema": { "const": "./schemas/home.schema.json" },
    "schemaVersion": { "const": 1 },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "heading", "subheading", "primaryAction", "secondaryAction", "featureAlt"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "heading": { "$ref": "#/$defs/text" },
        "subheading": { "type": "string", "minLength": 1, "maxLength": 400 },
        "featureAlt": { "type": "string", "minLength": 1, "maxLength": 160 },
        "primaryAction": { "$ref": "#/$defs/action" },
        "secondaryAction": {
          "allOf": [
            { "$ref": "#/$defs/action" },
            {
              "type": "object",
              "required": ["authMode"],
              "properties": { "authMode": { "enum": ["signup", "signin"] } }
            }
          ]
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "order", "visible"],
        "properties": {
          "componentId": { "enum": ["home.hero", "catalog.shell", "home.layout-blocks"] },
          "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "visible": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 120 },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "href": { "type": "string", "pattern": "^#[a-z0-9-]+$" },
        "authMode": { "enum": ["signup", "signin"] }
      }
    }
  }
}
