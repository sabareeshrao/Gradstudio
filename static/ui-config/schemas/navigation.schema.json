{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradstudio.org/schemas/ui/navigation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "items"],
  "properties": {
    "$schema": { "const": "./schemas/navigation.schema.json" },
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "route", "kind", "label", "href", "order", "visible"],
      "properties": {
        "componentId": { "type": "string", "pattern": "^site\\.primary-nav\\.[a-z0-9-]+$" },
        "route": { "enum": ["home", "courses", "about", "contact"] },
        "kind": { "enum": ["link", "menu-button"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "href": { "type": "string", "pattern": "^#[a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "visible": { "type": "boolean" }
      }
    }
  }
}
