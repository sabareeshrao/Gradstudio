{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradstudio.org/schemas/ui/footer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "description", "copyright", "links"],
  "properties": {
    "$schema": { "const": "./schemas/footer.schema.json" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "copyright": { "type": "string", "minLength": 1, "maxLength": 160 },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "route", "label", "href", "order", "visible"],
        "properties": {
          "componentId": { "type": "string", "pattern": "^site\\.footer\\.[a-z0-9-]+$" },
          "route": { "enum": ["about", "contact", "legal", "privacy", "terms", "cookies"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "href": { "type": "string", "pattern": "^#[a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "visible": { "type": "boolean" }
        }
      }
    }
  }
}
